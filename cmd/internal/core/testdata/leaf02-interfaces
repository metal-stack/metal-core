# This file describes the network interfaces available on your system
# and how to activate them. For more information, see interfaces(5).

source /etc/network/interfaces.d/*.intf

# The loopback network interface
auto lo
iface lo inet loopback
    address 10.1.1.1/32

# The primary network interface
auto eth0
iface eth0
    address 
    gateway 
    vrf mgmt

auto mgmt
iface mgmt
    address 127.0.0.1/8
    vrf-table auto

auto swp31
iface swp31
    mtu 9216

auto swp32
iface swp32
    mtu 9216

auto swp5
iface swp5
    mtu 9216

auto bridge
iface bridge
    bridge-ports vni104000 swp1 swp2 swp3 swp4 vni100 vni200
    bridge-vids 4000 1001 1002
    bridge-vlan-aware yes

# Tenants

auto vrf100
iface vrf100
    vrf-table auto

auto swp7
iface swp7
    mtu 9000
    post-up sysctl -w net.ipv6.conf.swp7.disable_ipv6=0
    vrf vrf100

auto vlan1001
iface vlan1001
    mtu 9000
    vlan-id 1001
    vlan-raw-device bridge
    vrf vrf100

auto vni100
iface vni100
    mtu 9000
    bridge-access 1001
    bridge-arp-nd-suppress on
    bridge-learning off
    mstpctl-bpduguard yes
    mstpctl-portbpdufilter yes
    vxlan-id 100
    vxlan-local-tunnelip 10.1.1.1

auto vrf200
iface vrf200
    vrf-table auto

auto swp6
iface swp6
    mtu 9000
    post-up sysctl -w net.ipv6.conf.swp6.disable_ipv6=0
    vrf vrf200

auto vlan1002
iface vlan1002
    mtu 9000
    vlan-id 1002
    vlan-raw-device bridge
    vrf vrf200

auto vni200
iface vni200
    mtu 9000
    bridge-access 1002
    bridge-arp-nd-suppress on
    bridge-learning off
    mstpctl-bpduguard yes
    mstpctl-portbpdufilter yes
    vxlan-id 200
    vxlan-local-tunnelip 10.1.1.1

# PXE-Config
auto vlan4000
iface vlan4000
    mtu 9000
    address 10.255.0.1/24
    vlan-id 4000
    vlan-raw-device bridge

auto vni104000
iface vni104000
    mtu 9000
    bridge-access 4000
    bridge-learning off
    mstpctl-bpduguard yes
    mstpctl-portbpdufilter yes
    vxlan-id 104000
    vxlan-local-tunnelip 10.1.1.1

auto swp1
iface swp1
    mtu 9000
    bridge-access 4000

auto swp2
iface swp2
    mtu 9000
    bridge-access 4000

auto swp3
iface swp3
    mtu 9000
    bridge-access 4000

auto swp4
iface swp4
    mtu 9000
    bridge-access 4000
